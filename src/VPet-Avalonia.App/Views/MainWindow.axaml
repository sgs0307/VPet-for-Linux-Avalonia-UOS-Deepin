<Window x:Class="VPetAvalonia.App.Views.MainWindow" xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:VPetAvalonia.App.Views"
        mc:Ignorable="d" d:DesignWidth="1920" d:DesignHeight="1080"
        Title="VPet 虚拟桌宠"
        SystemDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        CanResize="False"
        ShowActivated="False"
        WindowStartupLocation="Manual">

    <!-- 桌宠窗口: 铺满整个屏幕, 背景完全透明, 只有宠物本体可见可点 -->
    <Grid x:Name="Root" Background="Transparent">
        <Canvas x:Name="PetCanvas" Background="Transparent">
            <views:Main x:Name="MainDisplay" Width="500" Height="500" />

            <!-- 对话气泡, 显示在宠物上方 -->
            <views:MessageBar x:Name="MessageBar" Width="420" IsVisible="False" />

            <!-- 工作计时器 -->
            <views:WorkTimer x:Name="WorkTimer" Width="300" Height="200" IsVisible="False" />

            <!-- 右键菜单: 项目当前没有引入 Avalonia 主题包,
                 MenuItem 等需要控件模板的控件在无主题时不会渲染,
                 因此这里用 Border + TextBlock 自行绘制, 保证任何环境下都能用。
                 MaxHeight 由代码按窗口高度动态设置: 工作/商店这类长列表不限制高度
                 会超出屏幕被窗口裁掉(看起来就是"菜单显示不全") -->
            <Border x:Name="ContextPanel" Background="#E62b2b2b" BorderBrush="#404040"
                    BorderThickness="1" CornerRadius="8" Padding="4" Width="210"
                    IsVisible="False">
                <ScrollViewer x:Name="ContextScroll"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="ContextItems" />
                </ScrollViewer>
            </Border>
        </Canvas>
    </Grid>
</Window>
