<UserControl x:Class="VPetAvalonia.App.Views.WorkTimer" xmlns="https://github.com/avaloniaui"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
              mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="180">
    <Grid>
        <Border x:Name="bdRoot" BorderBrush="#0290D5" BorderThickness="4" CornerRadius="5"
                Background="#81d4fa" Margin="10,10,0,0">
            <Grid Height="180" Width="300">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*" />
                    <RowDefinition Height="4*" />
                    <RowDefinition Height="1.5*" />
                </Grid.RowDefinitions>
                
                <TextBlock x:Name="tNow" Text="当前已工作" Foreground="#0286C6" FontSize="36" FontWeight="Bold"
                           HorizontalAlignment="Right" VerticalAlignment="Center" Margin="45,0,5,0" Grid.ColumnSpan="2"/>
                
                <TextBlock x:Name="tNumber" Text="15.0" FontSize="80" FontWeight="Bold"
                           Foreground="#0286C6" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Row="1"/>
                
                <TextBlock x:Name="tNumberUnit" Text="分钟" Foreground="#0286C6" Grid.Row="1"
                           Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,15" FontSize="36"/>
                
                <ProgressBar x:Name="PBLeft" Grid.Row="2" Grid.ColumnSpan="2" Value="20"/>
                
                <Button x:Name="btnStop" Grid.Row="2" Grid.ColumnSpan="2"
                        Background="#AA0286C6" Foreground="White" Content="停止工作" FontSize="24" Click="btnStop_Click"/>
            </Grid>
        </Border>
        
        <Button x:Name="btnSwitch" HorizontalAlignment="Left" VerticalAlignment="Top" Padding="5,5,8,7"
                Background="#0290D5" Click="SwitchState_Click">
            <Path Fill="White" Data="M3 2.9918C3 2.44405 3.44495 2 3.9934 2H20.0066C20.5552 2 21 2.45531 21 2.9918V21.0082C21 21.556 20.5551 22 20.0066 22H3.9934C3.44476 22 3 21.5447 3 21.0082V2.9918ZM19 11V4H5V11H19ZM19 13H5V20H19V13ZM9 6H15V8H9V6ZM9 15H15V17H9V15Z"/>
        </Button>
    </Grid>
</UserControl>